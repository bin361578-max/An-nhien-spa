# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER-SIDE MULTI-ROLE AUTHENTICATION (XÁC THỰC BẢO MẬT PHÍA MÁY CHỦ)
# ==============================================================================
# Lưu ý: Các biến này CHỈ chạy trên máy chủ (Node.js/Vercel Serverless Function).
# TUYỆT ĐỐI KHÔNG thêm tiền tố VITE_ để tránh bị đóng gói vào mã nguồn client.
# Cấu hình trên Vercel: Dashboard > Project > Settings > Environment Variables.

# ADMIN_EMAIL: Địa chỉ email quản trị viên duy nhất do chủ website thiết lập.
ADMIN_EMAIL="admin@annhienspa.vn"

# ADMIN_PASSWORD: Mật khẩu quản trị viên (máy chủ băm PBKDF2 + Salt 10,000 vòng SHA-512).
ADMIN_PASSWORD="AnNhien@Admin2026Secure!"

# ADMIN_JWT_SECRET / AUTH_SECRET: Chuỗi bí mật dùng để ký token HMAC-SHA256 (12 giờ).
ADMIN_JWT_SECRET="annhien_spa_secure_server_secret_key_2026_x89f2a"

# STAFF_EMAIL: Email nhân viên kỹ thuật khởi tạo ban đầu (quản trị viên có thể tạo thêm trong Dashboard).
STAFF_EMAIL="nhanvien@annhienspa.vn"

# STAFF_PASSWORD: Mật khẩu ban đầu của nhân viên (máy chủ băm PBKDF2 + Salt).
STAFF_PASSWORD="NhanVien@AnNhien2026!"
